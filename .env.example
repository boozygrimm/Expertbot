TELEGRAM_TOKEN=
MONGO_URI=
ADMIN_ID=980561369

# Comma-separated lists are supported.
GEMINI_KEYS=
GROQ_KEYS=
OPENROUTER_KEYS=

# Web search: Tavily primary, Firecrawl keyless fallback.
# Leave blank to retain the legacy search until Tavily is configured.
TAVILY_API_KEY=

# Optional dedicated key for game prompts.
GEMINI_GAME_KEY=

# Optional model overrides (defaults live in models.py).
# Lists are comma-separated: the order defines the fallback chain.
GROQ_FAST_MODELS=openai/gpt-oss-20b
GROQ_STRONG_MODELS=openai/gpt-oss-120b,qwen/qwen3.8-27b
GROQ_IMAGE_PROMPT_MODEL=openai/gpt-oss-20b
GROQ_TRANSCRIBE_MODELS=whisper-large-v3,whisper-large-v3-turbo
GEMINI_CHAT_MODEL=gemini-3-flash-preview
OPENROUTER_TEXT_MODEL=google/gemma-3-27b-it:free
OPENROUTER_VISION_MODEL=qwen/qwen3-vl-30b-thinking:free
OPENROUTER_SUMMARY_MODEL=qwen/qwen-2.5-72b-instruct:free

# Optional runtime variables for hosted environments.
PORT=7860
SPACE_ID=

# Experimental video worker; leave blank until configured.
BENDER_WORKER_URL=
BENDER_WORKER_KEY=
