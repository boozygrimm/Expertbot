TELEGRAM_TOKEN=
MONGO_URI=
ADMIN_ID=980561369

# Comma-separated lists are supported.
GEMINI_KEYS=
GROQ_KEYS=
OPENROUTER_KEYS=
# Исторические имена тех же ключей: читаются, если GEMINI_KEYS/GROQ_KEYS пусты.
# GEMINI_API_KEYS=
# GROQ_API_KEY=

# Ключи синтеза речи: нужны студии кружков и голосовых (video_prototype).
# Без них видео-пайплайн работает, а озвучка недоступна.
GEMINI_TTS_KEYS=
# TTS-провайдер студии: tera (по умолчанию) или другой поддерживаемый.
BENDER_TTS_PROVIDER=tera
# С какого номера начинать голосовые фрагменты (для дозаписи длинных текстов).
BENDER_TTS_START_INDEX=0

# Web search: Tavily primary, Firecrawl keyless fallback.
# Leave blank to retain the legacy search until Tavily is configured.
TAVILY_API_KEY=
# Search images and the drawing provider are managed in the owner's /panel.
# Cloudflare credentials are needed only if that provider is used.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_AI_TOKEN=
# Начальное значение этих двух переключателей; дальше их меняет владелец в /panel.
IMAGE_PROVIDER_MODE=legacy
SEARCH_IMAGES=disabled

# Optional dedicated key for game prompts.
GEMINI_GAME_KEY=

# Optional model overrides (defaults live in models.py).
# Lists are comma-separated: the order defines the fallback chain.
GROQ_FAST_MODELS=openai/gpt-oss-20b
GROQ_STRONG_MODELS=openai/gpt-oss-120b,qwen/qwen3.8-27b
GROQ_IMAGE_PROMPT_MODEL=openai/gpt-oss-20b
GROQ_TRANSCRIBE_MODELS=whisper-large-v3,whisper-large-v3-turbo
GEMINI_CHAT_MODEL=gemini-3-flash-preview
OPENROUTER_TEXT_MODEL=google/gemma-3-27b-it:free
OPENROUTER_VISION_MODEL=qwen/qwen3-vl-30b-thinking:free
OPENROUTER_SUMMARY_MODEL=qwen/qwen-2.5-72b-instruct:free

# `PATH` отдельно не описан: он читается только для поиска ffmpeg/ffprobe.

# Optional runtime variables for hosted environments.
PORT=7860
SPACE_ID=

# Bender studio worker (video notes and voice replies); leave blank until configured.
BENDER_WORKER_URL=
BENDER_WORKER_KEY=

# Отдельный видео-воркер на systemd (video_prototype/worker.py). Это НЕ процесс
# бота: без этих значений воркер не стартует, а бот работает как обычно.
BOT_TOKEN=
VIDEO_WORKER_KEY=
STORAGE_CHANNEL_ID=
NEWS_WORKER_ENABLED=0

# Owner-only news settings are managed in the owner's /panel.
# The worker must separately support news-story-image-v1 for illustrated stories.
# Флаги ниже включают устаревшие ручные контуры новостей в самом боте.
# По умолчанию всё выключено; в обычной работе не нужны.
NEWS_INTAKE_ENABLED=0
NEWS_COLLECTION_ENABLED=0
NEWS_EDITOR_ENABLED=0
NEWS_REVIEW_ENABLED=0
NEWS_RENDER_QUEUE_ENABLED=0

# Пробные контуры владельца: по умолчанию выключены и включаются осознанно.
# NEWS_OWNER_TRIAL_ENABLED=0
# NEWS_OWNER_DRAFT_ENABLED=0
# NEWS_OWNER_DAILY_ENABLED=0
# NEWS_TRIAL_SHARED_QUEUE_CONFIRMED=0
